{
  "name": "collabboard-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time collaborative Kanban board backend built with Express and MongoDB",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "doc:tree:md": "npx tree-node-cli -I \"node_modules|.git|coverage|dist\" -a -o STRUCTURE.md"
  },
  "keywords": [
    "express",
    "kanban",
    "socket.io",
    "mongodb"
  ],
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.13",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.0.0",
    "js-yaml": "^5.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.0",
    "tree-node-cli": "^3.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true
  }
}
